{
  "name": "cinematic-shorts-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/dashboard-contract.test.js test/media-pipeline.test.js test/pipeline-convergence.test.js test/quality-gates.test.js",
    "quality:report": "node scripts/quality-eval-report.mjs",
    "test:smoke": "node scripts/smoke-check.mjs",
    "openshot:bridge": "node scripts/install-openshot-bridge.mjs",
    "codex:doctor": "set \"CODEX_HOME=C:\\Users\\com\\.codex\" && codex doctor",
    "codex:test": "set \"CODEX_HOME=C:\\Users\\com\\.codex\" && codex exec -C . --sandbox read-only --skip-git-repo-check --ephemeral \"Reply with OK only.\""
  },
  "dependencies": {
    "@openai/codex": "^0.147.0",
    "@openai/codex-sdk": "^0.147.0"
  }
}
